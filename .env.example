# ───────── Brasil Fiscal — variáveis de ambiente ─────────
# Copie para .env.local. NUNCA commite segredos reais.

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable): usada só para login. Seguro expor no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE servidor. Ignora RLS. Jamais com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de 32 bytes em base64 que cifra (AES-256-GCM) as credenciais das fontes salvas pelo painel.
#   openssl rand -base64 32
# Se perdida, as credenciais salvas precisam ser cadastradas de novo.
CREDENTIALS_ENCRYPTION_KEY=

# Segredo do endpoint /api/cron/health (testa as fontes ativas e poda logs). Enviado como "Authorization: Bearer <valor>".
#   openssl rand -hex 32
CRON_SECRET=

# Chave ANTERIOR, só durante uma rotação (veja scripts/rotate-credentials-key.mjs). Remova depois de rotacionar.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# MFA (TOTP) obrigatório para administradores. Em produção é obrigatório por padrão; use 0 apenas para desligar de propósito.
# Em desenvolvimento use 1 para testar o fluxo (requer MFA habilitado em Supabase → Authentication → Multi-Factor).
ADMIN_REQUIRE_MFA=

# Rate limit GLOBAL (Redis via Upstash REST). Opcional: sem estas variáveis o limite é por instância (memória).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública do site (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limite do banco (MB) usado no indicador de uso. Supabase Free = 500.
DATABASE_LIMIT_MB=500

# ───────── Credenciais padrão das fontes (opcionais) ─────────
# O painel (Admin → Fontes de Dados → Configurar) tem precedência sobre estas variáveis.
# Portal da Transparência: cadastre-se em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=
# dados.gov.br: token em https://dados.gov.br (Minha conta → Token de acesso)
DADOS_GOV_BR_TOKEN=
