{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasil-fiscal",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Valores PÚBLICOS (a chave publishable do Supabase foi feita para ficar no navegador). Os segredos NÃO ficam aqui.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://tyhhowdudxwzowqhheng.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_YlrayFVxs1tZGyAojLUfaw_FpxZehHe"
  },
  "keep_vars": true,
  "observability": { "enabled": true },
  // Verificação diária das fontes (06:00 UTC = 03:00 em Brasília): chama /api/cron/health dentro do próprio Worker.
  "triggers": { "crons": ["0 6 * * *"] }
  // Variáveis e segredos NÃO ficam aqui: cadastre no painel da Cloudflare (veja docs/GUIA_IMPLANTACAO.md).
}
