# Brasil Fiscal — modelo das variáveis para cadastrar no painel da Cloudflare (Worker → Settings → Variables and Secrets).
# Formato NOME=valor, sem aspas e sem espaços ao redor do "=". Troque tudo que começa com TROQUE.
# NUNCA coloque valores reais neste arquivo no GitHub: copie, preencha na sua ferramenta/painel e mantenha só lá.

# --- Públicas (já corretas; também precisam existir como variáveis de BUILD) ---
NEXT_PUBLIC_SUPABASE_URL=https://tyhhowdudxwzowqhheng.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YlrayFVxs1tZGyAojLUfaw_FpxZehHe
# Endereço final do site, sem barra no final. Ex.: https://brasil-fiscal.SEU-SUBDOMINIO.workers.dev
NEXT_PUBLIC_SITE_URL=https://TROQUE

# --- SECRETAS (tipo "Secret" no painel, jamais com prefixo NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → service_role
SUPABASE_SERVICE_ROLE_KEY=TROQUE_PELA_CHAVE_SERVICE_ROLE
# openssl rand -base64 32   (44 caracteres terminando em "="; faça backup: sem ela as credenciais salvas ficam ilegíveis)
CREDENTIALS_ENCRYPTION_KEY=TROQUE_POR_32_BYTES_EM_BASE64
# openssl rand -hex 32
CRON_SECRET=TROQUE_POR_HEX_ALEATORIO

# --- Opcionais ---
# Limite de requisições compartilhado entre instâncias (recomendado em produção na Cloudflare)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Tamanho do plano do banco, para o alerta de uso (MB)
# DATABASE_LIMIT_MB=500
